# Copy to .env for local `netlify dev`, and set the same keys in
# Netlify → Site settings → Environment variables for production.
# .env is git-ignored: never commit a real API key.

# Required — Brevo v3 API key (Brevo → SMTP & API → API keys).
BREVO_API_KEY=

# Required — must be a sender address validated in Brevo → Senders.
BREVO_SENDER_EMAIL=noreply@aventuredusucre.com
BREVO_SENDER_NAME=L'Aventure du Sucre

# Optional — who receives booking requests. Comma-separated.
# Defaults to reservation@ and administration@aventuredusucre.com.
BOOKING_RECIPIENTS=reservation@aventuredusucre.com,administration@aventuredusucre.com

# Optional — Brevo list id. When set, visitors who tick the consent box are
# added to (or updated in) this list. Leave empty to store no contacts.
BREVO_LIST_ID=

# Optional — set to "true" to send the visitor an automatic confirmation email.
BREVO_SEND_CONFIRMATION=false
